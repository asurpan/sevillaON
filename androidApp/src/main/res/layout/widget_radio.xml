<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget_glass"
    android:gravity="center_vertical">

    <!-- HEADER SUPERIOR CIAN Y LED VERDE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_status_led"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@android:drawable/presence_online" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="ON AIR GLOBAL • RADIO CB 27MHz"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:textStyle="bold" />

        <!-- BADGE ESTADO VERDE -->
        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_status_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="EN LÍNEA"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ZONA CENTRAL: CANAL Y BOTÓN PTT PROMINENTE DE GAMA ALTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEVILLA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:letterSpacing="0.02"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_widget_channel_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="CANAL 27"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTÓN PTT NEÓN CIAN REDONDEADO Y ELEGANTE -->
        <TextView
            android:id="@+id/widget_btn_ptt"
            android:layout_width="125dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_widget_button_ptt"
            android:gravity="center"
            android:text="🎙️ HABLAR"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
